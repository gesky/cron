rules_version = '2';

// Cron Web Studio · Regras do Firestore
// Princípio: tudo fechado por padrão; cada coleção libera só o mínimo necessário.
//
// - projects: visitante lê só os publicados; admin cria/edita/exclui com campos validados
// - leads: visitante só CRIA (campos validados + consentimento LGPD); só o admin lê,
//          e o admin só pode mudar status e anotações
// - admins: cada documento com o UID libera o painel (criado à mão no console)
// - qualquer outra coleção: bloqueada

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------- Admins ----------------
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------------- Projetos ----------------
    match /projects/{id} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validProject(request.resource.data);
      allow delete: if isAdmin();
    }

    function str(v, max) { return v is string && v.size() <= max; }

    function validProject(d) {
      return d.keys().hasOnly([
          'client', 'segment', 'title', 'description', 'quote', 'tags',
          'ctaLabel', 'siteLabel', 'siteUrl', 'image', 'imageAlt',
          'published', 'order', 'createdAt', 'updatedAt'
        ])
        && str(d.client, 60) && d.client.size() >= 2
        && str(d.title, 120) && d.title.size() >= 2
        && str(d.segment, 60)
        && str(d.description, 600)
        && d.quote is map && d.quote.keys().hasOnly(['text', 'author'])
        && str(d.quote.text, 300) && str(d.quote.author, 80)
        && d.tags is list && d.tags.size() <= 6
        && str(d.ctaLabel, 40) && str(d.siteLabel, 40)
        && str(d.siteUrl, 300) && (d.siteUrl == '' || d.siteUrl.matches('^https?://.+'))
        && str(d.imageAlt, 160)
        && d.image is string && d.image.size() <= 900000
        && (d.image == '' || d.image.matches('^data:image/(webp|png|jpeg);base64,.+'))
        && d.published is bool
        && d.order is int && d.order >= 0 && d.order <= 10;
    }

    // ---------------- Leads ----------------
    match /leads/{id} {
      allow create: if validLead(request.resource.data);
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && request.resource.data.status in ['novo', 'contato', 'proposta', 'fechado', 'perdido']
        && str(request.resource.data.notes, 5000);
      allow delete: if isAdmin();
    }

    function validLead(d) {
      return d.keys().hasOnly([
          'name', 'whatsapp', 'email', 'company', 'need', 'message',
          'source', 'sourceLabel', 'project',
          'consent', 'consentText', 'consentAt',
          'createdAt', 'status', 'notes', 'page', 'referrer', 'utm'
        ])
        && str(d.name, 120) && d.name.size() >= 2
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10,13}$')
        && str(d.email, 160) && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && str(d.company, 120)
        && d.need in ['', 'institucional', 'sistema', 'nao-sei']
        && str(d.message, 2000)
        && str(d.source, 80) && str(d.sourceLabel, 120) && str(d.project, 120)
        && d.consent == true
        && str(d.consentText, 600)
        && d.consentAt == request.time
        && d.createdAt == request.time
        && d.status == 'novo'
        && d.notes == ''
        && str(d.page, 500) && str(d.referrer, 500)
        && d.utm is map && d.utm.size() <= 5
        && d.utm.keys().hasOnly(['source', 'medium', 'campaign', 'content', 'term'])
        && (!('source' in d.utm) || str(d.utm.source, 120))
        && (!('medium' in d.utm) || str(d.utm.medium, 120))
        && (!('campaign' in d.utm) || str(d.utm.campaign, 120))
        && (!('content' in d.utm) || str(d.utm.content, 120))
        && (!('term' in d.utm) || str(d.utm.term, 120));
    }

    // ---------------- Todo o resto: fechado ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
