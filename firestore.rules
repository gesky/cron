rules_version = '2';

// Cron Web Studio · Regras do Firestore
// Princípio: tudo fechado por padrão; cada coleção libera só o mínimo necessário.
//
// - projects: visitante lê só os publicados; admin cria/edita/exclui com campos validados
// - leads: visitante só CRIA pelo formulário (campos validados + consentimento LGPD);
//          o admin lê, cadastra leads manuais e edita os campos de CRM (nunca consentimento,
//          UTM, data de criação ou de onde o lead clicou no site)
// - leads/{id}/interacoes: histórico do lead; admin e CronUS leem e criam; só o admin apaga
//          (ao excluir o lead); ninguém edita
// - leads/{id}/kit/marca: logo e produtos do lead (fora do documento do lead); admin em
//          qualquer lead, CronUS só nos leads dele
// - leads/{id}/previews/{pid}: índice privado das prévias do lead (nicho e motivo do formato)
// - previews: sites modelo; visitante lê só a prévia ativa pelo id (nunca lista); admin e
//          CronUS criam e editam; só o admin apaga
// - rodadas: rodadas de prospecção; admin e CronUS leem, criam e editam; só o admin arquiva
//          ou desarquiva; ninguém apaga
// - admins: cada documento com o UID libera o painel; admins gerenciam outros admins
//           pelo painel (ninguém remove o próprio acesso nem o do dono)
// - bots: cada documento com o UID libera o CronUS a gravar prospecção (nunca entra no painel)
// - config/owner: UID do dono do sistema; criado só pelo Console do Firebase, nunca pelo app
// - qualquer outra coleção: bloqueada
//
// O CronUS (bot) lê leads, histórico, kit, prévias e rodadas; cria e atualiza só o que é
// dele (leads com origin e createdBy 'cronus'); nunca apaga, nunca aprova nem reescreve
// mensagem aprovada ou enviada, nunca fecha ou perde lead, nunca arquiva nem desarquiva rodada
// e nunca toca em projetos, admins, bots ou config.
//
// Orçamento: o Firestore avalia no máximo 1000 expressões por gravação. Por isso:
// - a validação pesada (validCrmFields, validPreview, validKit) aparece uma vez só em cada
//   allow, depois do teste de papel;
// - cada lista é conferida numa expressão só (join com o separador ¶ e uma regex), sem
//   conferir posição por posição; os produtos ficam em quatro listas paralelas;
// - os campos de texto do lead vão juntos numa regex só;
// - no update de prévia, só os campos alterados são conferidos.
// O caractere ¶ não pode aparecer nos textos (o painel e o formulário trocam por espaço).
// Os testes (tests/rules) cobrem os documentos no limite: lead com todos os campos, prévia
// com 24 produtos e kit cheio.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // CronUS: conta dedicada com documento em bots/{uid}
    function isBot() {
      return request.auth != null
        && exists(/databases/$(database)/documents/bots/$(request.auth.uid));
    }

    function ownerPath() { return /databases/$(database)/documents/config/owner; }

    // Campos acrescentados ou alterados num update (os removidos ficam de fora)
    function changed(n, o) { let df = n.diff(o); return df.addedKeys().union(df.changedKeys()); }

    // ---------------- Admins ----------------
    match /admins/{uid} {
      // cada pessoa lê o próprio documento (o painel confere o acesso); admin lê todos
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // a mesma conta nunca é admin e bot ao mesmo tempo
      allow create: if isAdmin() && uid.matches('^[A-Za-z0-9]{20,40}$') && validAdmin(request.resource.data)
        && !exists(/databases/$(database)/documents/bots/$(uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && (!('name' in request.resource.data) || str(request.resource.data.name, 80))
        && (!('email' in request.resource.data) || mail(request.resource.data.email))
        && request.resource.data.updatedAt == request.time;
      // remover o acesso de outra pessoa; o próprio, nunca; o do dono, nunca.
      // Sem config/owner criado, ninguém remove admin pelo app (proposital).
      allow delete: if isAdmin() && request.auth.uid != uid
        && exists(ownerPath())
        && get(ownerPath()).data.uid != uid;
    }

    // ---------------- Bots (CronUS) ----------------
    match /bots/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && uid.matches('^[A-Za-z0-9]{20,40}$') && validBot(request.resource.data)
        && !exists(/databases/$(database)/documents/admins/$(uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && (!('name' in request.resource.data) || str(request.resource.data.name, 80))
        && (!('email' in request.resource.data) || mail(request.resource.data.email))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    function validBot(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'createdBy'])
        && str(d.name, 80) && d.name.size() >= 2
        && mail(d.email)
        && d.role == 'bot'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }

    // ---------------- Dono do sistema ----------------
    // Documento único config/owner { uid, createdAt }. Criado só no Console do Firebase
    // (que não passa pelas regras). Pelo app ninguém cria, altera ou apaga.
    match /config/{docId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    function validAdmin(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'createdBy'])
        && str(d.name, 80)
        && mail(d.email) && d.email.size() > 0
        && d.role == 'admin'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }

    // ---------------- Sites modelo (prévias) ----------------
    match /previews/{id} {
      // público abre só a prévia ativa, pelo id aleatório; nunca lista.
      // A condição barata vem primeiro: o visitante não paga as consultas de papel.
      allow get: if resource.data.active == true || isAdmin() || isBot();
      allow list: if isAdmin() || isBot();
      allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
          || (isBot() && request.resource.data.createdBy == 'cronus'))
        && request.resource.data.keys().hasAll(['template', 'format', 'companyName', 'active',
                                                'createdBy', 'createdAt', 'updatedAt'])
        && validPreview(request.resource.data, request.resource.data.keys())
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // no update, só os campos alterados são conferidos (desativar uma prévia é barato)
      allow update: if (isAdmin() || isBot())
        && validPreview(request.resource.data, changed(request.resource.data, resource.data))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      // só a exclusão completa do lead (LGPD) apaga; no dia a dia, desativa
      allow delete: if isAdmin();
    }

    // Imagem embutida: data URL de webp, png ou jpeg (ou vazio)
    function img(v, max) {
      return v is string && v.size() <= max
        && (v == '' || v.matches('^data:image/(webp|png|jpeg);base64,.+'));
    }
    function color(v) { return v is string && v.matches('^(#[0-9a-fA-F]{6})?$'); }

    // Listas de textos: a lista inteira é conferida sem laço. join('¶') junta os itens com o
    // separador ¶ e a regex limita cada item; join('') sem ¶ garante que nenhum item traz o
    // separador (senão um item valeria por dois).
    // Exemplo de re para itens de até 40 caracteres: '^[^¶]{0,40}(¶[^¶]{0,40})*$'
    function noSep(l) { return l.join('').matches('^[^¶]*$'); }
    function textList(l, n, re) { return l is list && l.size() <= n && noSep(l) && l.join('¶').matches(re); }

    // Produtos do catálogo (prévia e kit): até 24, em quatro listas paralelas do mesmo tamanho.
    // O produto i é names[i], descriptions[i], categories[i] e images[i] (modelo/produtos.js).
    // Imagem: data URL de webp, png ou jpeg em base64 (ou vazio); todas juntas até 720 mil
    // caracteres, para o documento caber no limite de 1 MB com a logo.
    function validProducts(p) {
      return p is map
        && p.keys().hasOnly(['names', 'descriptions', 'categories', 'images'])
        && p.names is list && p.names.size() <= 24
        && p.descriptions is list && p.descriptions.size() == p.names.size()
        && p.categories is list && p.categories.size() == p.names.size()
        && p.images is list && p.images.size() == p.names.size()
        && (p.names.join('') + p.descriptions.join('') + p.categories.join('') + p.images.join('')).matches('^[^¶]*$')
        && (p.names.size() == 0 || p.names.join('¶').matches('^[^¶]{1,60}(¶[^¶]{1,60})*$'))
        && p.descriptions.join('¶').matches('^[^¶]{0,160}(¶[^¶]{0,160})*$')
        && p.categories.join('¶').matches('^[^¶]{0,40}(¶[^¶]{0,40})*$')
        && p.images.join('¶').size() <= 720000
        && p.images.join('¶').matches('^(data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+)?(¶(data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+)?)*$');
    }

    function validTexts(t) {
      return t is map
        && t.keys().hasOnly(['headline', 'subheadline', 'about', 'ctaPrimary', 'ctaSecondary',
                             'contactTitle', 'contactText', 'catalogTitle', 'catalogText',
                             'diferenciais', 'benefits'])
        && (!('headline' in t) || t.headline.matches('^[\\s\\S]{0,120}$'))
        && (!('subheadline' in t) || t.subheadline.matches('^[\\s\\S]{0,240}$'))
        && (!('about' in t) || t.about.matches('^[\\s\\S]{0,900}$'))
        && (!('ctaPrimary' in t) || t.ctaPrimary.matches('^.{0,40}$'))
        && (!('ctaSecondary' in t) || t.ctaSecondary.matches('^.{0,40}$'))
        && (!('contactTitle' in t) || t.contactTitle.matches('^.{0,80}$'))
        && (!('contactText' in t) || t.contactText.matches('^[\\s\\S]{0,240}$'))
        && (!('catalogTitle' in t) || t.catalogTitle.matches('^.{0,80}$'))
        && (!('catalogText' in t) || t.catalogText.matches('^[\\s\\S]{0,240}$'))
        && (!('diferenciais' in t) || textList(t.diferenciais, 6, '^[^¶]{0,120}(¶[^¶]{0,120})*$'))
        && (!('benefits' in t) || textList(t.benefits, 6, '^[^¶]{0,120}(¶[^¶]{0,120})*$'));
    }

    // Prévia é pública por link: nada interno do lead (contatos, cidade, notas, motivos,
    // id do lead ou nicho). A ligação com o lead fica no índice privado leads/{id}/previews.
    // k = campos a conferir: todos na criação, só os alterados no update.
    function validPreview(d, k) {
      return d.keys().hasOnly(['template', 'format',
                               'companyName', 'tagline', 'mainService', 'services',
                               'primaryColor', 'secondaryColor', 'logo', 'products', 'categories',
                               'texts', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && (!('template' in k) || d.template.matches('^[a-z0-9_-]{2,60}$'))
        && (!('format' in k) || d.format in ['landing', 'institucional', 'catalogo'])
        && (!('companyName' in k) || d.companyName.matches('^.{2,120}$'))
        && (!('tagline' in k) || d.tagline.matches('^.{0,120}$'))
        && (!('mainService' in k) || d.mainService.matches('^.{0,80}$'))
        && (!('services' in k) || textList(d.services, 8, '^[^¶]{0,60}(¶[^¶]{0,60})*$'))
        && (!('primaryColor' in k) || color(d.primaryColor))
        && (!('secondaryColor' in k) || color(d.secondaryColor))
        && (!('logo' in k) || img(d.logo, 200000))
        && (!('products' in k) || validProducts(d.products))
        && (!('categories' in k) || textList(d.categories, 12, '^[^¶]{0,40}(¶[^¶]{0,40})*$'))
        && (!('texts' in k) || validTexts(d.texts))
        && (!('active' in k) || d.active is bool)
        && (!('createdBy' in k) || d.createdBy in ['admin', 'cronus']);
    }

    function validKit(d) {
      return d.keys().hasOnly(['logo', 'products', 'categories', 'updatedAt', 'updatedBy'])
        && (!('logo' in d) || img(d.logo, 200000))
        && (!('products' in d) || validProducts(d.products))
        && (!('categories' in d) || textList(d.categories, 12, '^[^¶]{0,40}(¶[^¶]{0,40})*$'))
        && d.updatedAt == request.time
        && d.updatedBy in ['admin', 'cronus'];
    }

    // Índice privado de prévias do lead: id igual ao da prévia pública
    function validPreviewIndex(d) {
      return d.keys().hasOnly(['niche', 'formatReason', 'createdAt'])
        && (!('niche' in d) || (d.niche is string && d.niche.matches('^([a-z0-9-]{2,60})?$')))
        && (!('formatReason' in d) || d.formatReason.matches('^[\\s\\S]{0,300}$'))
        && d.createdAt is timestamp;
    }

    function validBrand(m) {
      return m is map
        && m.keys().hasOnly(['primaryColor', 'secondaryColor', 'tagline', 'mainService', 'services'])
        && color(m.get('primaryColor', ''))
        && color(m.get('secondaryColor', ''))
        && m.get('tagline', '').matches('^.{0,120}$')
        && m.get('mainService', '').matches('^.{0,80}$')
        && textList(m.get('services', []), 8, '^[^¶]{0,60}(¶[^¶]{0,60})*$');
    }

    // ---------------- Rodadas de prospecção ----------------
    match /rodadas/{id} {
      allow get, list: if isAdmin() || isBot();
      allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
          || (isBot() && request.resource.data.createdBy == 'cronus'))
        && request.resource.data.createdAt == request.time
        && validRodada(request.resource.data);
      // o bot atualiza tudo menos arquivar ou desarquivar (decisão do admin)
      allow update: if (isAdmin() || (isBot()
          && resource.data.status != 'arquivada'
          && request.resource.data.status != 'arquivada'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['niche', 'nicheLabel', 'region', 'criteria', 'funnel', 'status', 'notes', 'updatedAt'])
        && validRodada(request.resource.data);
      allow delete: if false;
    }

    function siteStAt(l, i) { return l.size() <= i || l[i] in ['sem_site', 'site_fraco', 'ok']; }
    function cnt(m, k) { return !(k in m) || (m[k] is int && m[k] >= 0 && m[k] <= 100000); }

    function validRodada(d) {
      return d.keys().hasOnly(['niche', 'nicheLabel', 'region', 'criteria', 'funnel', 'status', 'notes',
                               'createdBy', 'createdAt', 'updatedAt'])
        && d.niche is string && d.niche.matches('^[a-z0-9-]{2,60}$')
        && str(d.nicheLabel, 80)
        && (!('region' in d) || str(d.region, 120))
        && (!('notes' in d) || str(d.notes, 2000))
        && d.status in ['em_andamento', 'concluida', 'arquivada']
        && d.createdBy in ['admin', 'cronus']
        && (!('criteria' in d) || (d.criteria is map
            && d.criteria.keys().hasOnly(['minRating', 'minReviews', 'siteStatusAccepted', 'requireContact'])
            && (!('minRating' in d.criteria) || (d.criteria.minRating is number && d.criteria.minRating >= 0 && d.criteria.minRating <= 5))
            && (!('minReviews' in d.criteria) || (d.criteria.minReviews is int && d.criteria.minReviews >= 0 && d.criteria.minReviews <= 100000))
            && (!('requireContact' in d.criteria) || d.criteria.requireContact is bool)
            && (!('siteStatusAccepted' in d.criteria) || (d.criteria.siteStatusAccepted is list
                && d.criteria.siteStatusAccepted.size() <= 3
                && siteStAt(d.criteria.siteStatusAccepted, 0)
                && siteStAt(d.criteria.siteStatusAccepted, 1)
                && siteStAt(d.criteria.siteStatusAccepted, 2)))))
        && (!('funnel' in d) || (d.funnel is map
            && d.funnel.keys().hasOnly(['encontradas', 'notaMinima', 'avaliacoes', 'siteSemOuFraco', 'comContato', 'qualificadas'])
            && cnt(d.funnel, 'encontradas') && cnt(d.funnel, 'notaMinima') && cnt(d.funnel, 'avaliacoes')
            && cnt(d.funnel, 'siteSemOuFraco') && cnt(d.funnel, 'comContato') && cnt(d.funnel, 'qualificadas')));
    }

    // ---------------- Projetos ----------------
    match /projects/{id} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validProject(request.resource.data);
      allow delete: if isAdmin();
    }

    function str(v, max) { return v is string && v.size() <= max; }

    function validProject(d) {
      return d.keys().hasOnly([
          'client', 'segment', 'title', 'description', 'quote', 'tags',
          'ctaLabel', 'siteLabel', 'siteUrl', 'image', 'imageAlt',
          'published', 'order', 'createdAt', 'updatedAt'
        ])
        && str(d.client, 60) && d.client.size() >= 2
        && str(d.title, 120) && d.title.size() >= 2
        && str(d.segment, 60)
        && str(d.description, 600)
        && d.quote is map && d.quote.keys().hasOnly(['text', 'author'])
        && str(d.quote.text, 300) && str(d.quote.author, 80)
        && d.tags is list && d.tags.size() <= 6
        && str(d.ctaLabel, 40) && str(d.siteLabel, 40)
        && str(d.siteUrl, 300) && (d.siteUrl == '' || d.siteUrl.matches('^https?://.+'))
        && str(d.imageAlt, 160)
        && d.image is string && d.image.size() <= 900000
        && (d.image == '' || d.image.matches('^data:image/(webp|png|jpeg);base64,.+'))
        && d.published is bool
        && d.order is int && d.order >= 0 && d.order <= 10;
    }

    // ---------------- Leads ----------------
    match /leads/{id} {
      // Cadastro manual pelo admin ou lead do CronUS (validCrmFields uma vez só, depois do
      // papel); por último, o formulário do site (exatamente como antes).
      allow create: if (((isBot() && botLeadShape(request.resource.data))
            || (isAdmin() && crmLeadShape(request.resource.data)))
          && validCrmFields(request.resource.data))
        || validLead(request.resource.data);
      allow get, list: if isAdmin() || isBot();
      // Admin edita só campos de CRM; o documento resultante precisa continuar válido.
      // Bot edita só leads que ele criou (origin e createdBy 'cronus') e só os campos dele.
      allow update: if ((isBot() && isBotLead(resource.data)
            && botUpdate(request.resource.data, resource.data))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(crmEditable())))
        && validCrmFields(request.resource.data);
      allow delete: if isAdmin();

      // Kit da marca (logo e produtos): documento único 'marca'. Apagado só na exclusão completa.
      // O bot grava só no kit de lead de prospecção.
      match /kit/{docId} {
        allow get, list: if isAdmin() || isBot();
        allow create, update: if docId == 'marca'
          && ((isAdmin() && request.resource.data.updatedBy == 'admin')
            || (isBot() && request.resource.data.updatedBy == 'cronus'
              && isBotLead(getAfter(/databases/$(database)/documents/leads/$(id)).data)))
          && validKit(request.resource.data);
        allow delete: if isAdmin();
      }

      // Índice privado das prévias do lead (a prévia pública não sabe de qual lead é)
      match /previews/{pid} {
        allow get, list: if isAdmin() || isBot();
        allow create: if (isAdmin() || isBot())
          && validPreviewIndex(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if (isAdmin() || isBot())
          && validPreviewIndex(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin();
      }

      // Histórico: ninguém edita. O admin apaga só junto com o lead (exclusão completa, LGPD).
      match /interacoes/{iid} {
        allow get, list: if isAdmin() || isBot();
        allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
            || (isBot() && request.resource.data.createdBy == 'cronus'))
          && validInteraction(request.resource.data);
        allow delete: if isAdmin();
        allow update: if false;
      }
    }

    // Formulário público do site (sem mudanças)
    function validLead(d) {
      return d.keys().hasOnly([
          'name', 'whatsapp', 'email', 'company', 'need', 'message',
          'source', 'sourceLabel', 'project',
          'consent', 'consentText', 'consentAt',
          'createdAt', 'status', 'notes', 'page', 'referrer', 'utm'
        ])
        && str(d.name, 120) && d.name.size() >= 2
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10,13}$')
        && str(d.email, 160) && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && str(d.company, 120)
        && d.need in ['', 'institucional', 'sistema', 'nao-sei']
        && str(d.message, 2000)
        && str(d.source, 80) && str(d.sourceLabel, 120) && str(d.project, 120)
        && d.consent == true
        && str(d.consentText, 600)
        && d.consentAt == request.time
        && d.createdAt == request.time
        && d.status == 'novo'
        && d.notes == ''
        && str(d.page, 500) && str(d.referrer, 500)
        && d.utm is map && d.utm.size() <= 5
        && d.utm.keys().hasOnly(['source', 'medium', 'campaign', 'content', 'term'])
        && (!('source' in d.utm) || str(d.utm.source, 120))
        && (!('medium' in d.utm) || str(d.utm.medium, 120))
        && (!('campaign' in d.utm) || str(d.utm.campaign, 120))
        && (!('content' in d.utm) || str(d.utm.content, 120))
        && (!('term' in d.utm) || str(d.utm.term, 120));
    }

    // Campos que o admin pode alterar num lead existente.
    // Fora da lista (imutáveis): createdAt, createdBy, consent, consentText, consentAt,
    // utm, source, sourceLabel, project, page, referrer, message.
    // (a lista do bot mais os campos que só o admin mexe; uma lista só, para não pesar)
    function crmEditable() {
      return botEditable().concat(['notes', 'origin', 'owner', 'lostReason', 'discardReason']);
    }


    // http/https de até 300 caracteres, ou vazio
    function url(v) { return v.matches('^(https?://.{1,292})?$'); }
    // e-mail (até 64 caracteres antes do @), ou vazio
    function mail(v) { return v.matches('^([^@\\s]{1,64}@[^@\\s]{1,100}\\.[^@\\s]{1,24})?$'); }
    function tsOrNull(v) { return v == null || v is timestamp; }

    // Valida os campos de CRM (todos opcionais, exceto status).
    // Os campos de texto vão juntos, na ordem abaixo, num texto só separado por ¶, conferido por
    // uma regex só: o + entre textos recusa número, booleano ou null (tipo continua sendo texto)
    // e cada trecho tem a sua regra. Campo ausente entra com o padrão, que passa na própria regra.
    // Um ¶ dentro de um campo cria um trecho a mais e a regex recusa (o painel tira o ¶ ao gravar).
    //   status            (novo|mensagem_pronta|abordado|respondeu|em_conversa|reuniao|proposta|fechado|perdido|contato)
    //   notes             [^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}
    //   name              [^¶\n]{0,120}
    //   company           [^¶\n]{0,120}
    //   whatsapp          ([0-9]{10,13})?
    //   email             ([^@\s¶]{1,64}@[^@\s¶]{1,80}\.[^@\s¶]{1,13})?
    //   need              (|institucional|sistema|nao-sei)
    //   origin            (site|cronus|indicacao|manual)
    //   role              [^¶\n]{0,80}
    //   instagram         [A-Za-z0-9._]{0,30}
    //   niche             [a-z0-9-]{0,60}
    //   city              [^¶\n]{0,80}
    //   state             ([A-Z]{2})?
    //   currentSite       (https?://[^¶\n]{1,292})?
    //   siteStatus        (|sem_site|site_fraco|ok)
    //   siteReason        [^¶]{0,300}
    //   cnpj              ([0-9]{14})?
    //   phone             ([0-9]{8,13})?
    //   linkedin          (https?://[^¶\n]{1,292})?
    //   companyLinkedin   (https?://[^¶\n]{1,292})?
    //   companyEmail      ([^@\s¶]{1,64}@[^@\s¶]{1,80}\.[^@\s¶]{1,13})?
    //   cnpjEmail         ([^@\s¶]{1,64}@[^@\s¶]{1,80}\.[^@\s¶]{1,13})?
    //   cnpjPhone         ([0-9]{8,13})?
    //   legalName         [^¶\n]{0,160}
    //   googleMapsUrl     (https?://[^¶\n]{1,292})?
    //   facebook          (https?://[^¶\n]{1,292})?
    //   address           [^¶]{0,300}
    //   channel           (|whatsapp|instagram|email)
    //   fitReason         [^¶]{0,600}
    //   previewId         [A-Za-z0-9]{0,40}
    //   batchId           [A-Za-z0-9]{0,40}
    //   owner             [^¶\n]{0,40}
    //   lostReason        [^¶]{0,300}
    //   prospectState     (pendente|aprovado|descartado)
    //   discardReason     [^¶]{0,300}
    //   qualification     (|qualificado|desqualificado)
    //   disqualifyReason  [^¶]{0,300}
    //   format            (|landing|institucional|catalogo)
    //   formatReason      [^¶]{0,300}
    function validCrmFields(d) {
      return (d.status
            + '¶' + d.get('notes', '')
            + '¶' + d.get('name', '')
            + '¶' + d.get('company', '')
            + '¶' + d.get('whatsapp', '')
            + '¶' + d.get('email', '')
            + '¶' + d.get('need', '')
            + '¶' + d.get('origin', 'site')
            + '¶' + d.get('role', '')
            + '¶' + d.get('instagram', '')
            + '¶' + d.get('niche', '')
            + '¶' + d.get('city', '')
            + '¶' + d.get('state', '')
            + '¶' + d.get('currentSite', '')
            + '¶' + d.get('siteStatus', '')
            + '¶' + d.get('siteReason', '')
            + '¶' + d.get('cnpj', '')
            + '¶' + d.get('phone', '')
            + '¶' + d.get('linkedin', '')
            + '¶' + d.get('companyLinkedin', '')
            + '¶' + d.get('companyEmail', '')
            + '¶' + d.get('cnpjEmail', '')
            + '¶' + d.get('cnpjPhone', '')
            + '¶' + d.get('legalName', '')
            + '¶' + d.get('googleMapsUrl', '')
            + '¶' + d.get('facebook', '')
            + '¶' + d.get('address', '')
            + '¶' + d.get('channel', '')
            + '¶' + d.get('fitReason', '')
            + '¶' + d.get('previewId', '')
            + '¶' + d.get('batchId', '')
            + '¶' + d.get('owner', '')
            + '¶' + d.get('lostReason', '')
            + '¶' + d.get('prospectState', 'pendente')
            + '¶' + d.get('discardReason', '')
            + '¶' + d.get('qualification', '')
            + '¶' + d.get('disqualifyReason', '')
            + '¶' + d.get('format', '')
            + '¶' + d.get('formatReason', ''))
          .matches('^(novo|mensagem_pronta|abordado|respondeu|em_conversa|reuniao|proposta|fechado|perdido|contato)¶[^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}[^¶]{0,1000}¶[^¶\\n]{0,120}¶[^¶\\n]{0,120}¶([0-9]{10,13})?¶([^@\\s¶]{1,64}@[^@\\s¶]{1,100}\\.[^@\\s¶]{1,24})?¶(|institucional|sistema|nao-sei)¶(site|cronus|indicacao|manual)¶[^¶\\n]{0,80}¶[A-Za-z0-9._]{0,30}¶[a-z0-9-]{0,60}¶[^¶\\n]{0,80}¶([A-Z]{2})?¶(https?://[^¶\\n]{1,292})?¶(|sem_site|site_fraco|ok)¶[^¶]{0,300}¶([0-9]{14})?¶([0-9]{8,13})?¶(https?://[^¶\\n]{1,292})?¶(https?://[^¶\\n]{1,292})?¶([^@\\s¶]{1,64}@[^@\\s¶]{1,100}\\.[^@\\s¶]{1,24})?¶([^@\\s¶]{1,64}@[^@\\s¶]{1,100}\\.[^@\\s¶]{1,24})?¶([0-9]{8,13})?¶[^¶\\n]{0,160}¶(https?://[^¶\\n]{1,292})?¶(https?://[^¶\\n]{1,292})?¶[^¶]{0,300}¶(|whatsapp|instagram|email)¶[^¶]{0,600}¶[A-Za-z0-9]{0,40}¶[A-Za-z0-9]{0,40}¶[^¶\\n]{0,40}¶[^¶]{0,300}¶(pendente|aprovado|descartado)¶[^¶]{0,300}¶(|qualificado|desqualificado)¶[^¶]{0,300}¶(|landing|institucional|catalogo)¶[^¶]{0,300}$')
        && d.get('stageAt', request.time) is timestamp
        && intIn(d.get('siteScore', 0), 10)
        && numIn(d.get('googleRating', 0), 5)
        && intIn(d.get('googleReviews', 0), 1000000)
        && intIn(d.get('companyYears', 0), 200)
        && validLinks(d.get('otherLinks', []))
        && validSources(d.get('sources', {}))
        && validDraft(d.get('draft', {}))
        && validNextStep(d.get('nextStep', {}))
        && tsOrNull(d.get('meetingAt', null))
        && validBrand(d.get('brand', {}))
        && validDrafts(d.get('drafts', {}));
    }
    function intIn(v, max) { return v is int && v >= 0 && v <= max; }
    function numIn(v, max) { return v is number && v >= 0 && v <= max; }
    function validDrafts(m) {
      return m is map && m.keys().hasOnly(['whatsapp', 'instagram', 'email'])
        && m.get('whatsapp', '').matches('^[\\s\\S]{0,1000}[\\s\\S]{0,1000}$')
        && m.get('instagram', '').matches('^[\\s\\S]{0,1000}[\\s\\S]{0,1000}$')
        && m.get('email', '').matches('^[\\s\\S]{0,1000}[\\s\\S]{0,1000}$');
    }

    // Até 10 links, cada um http/https de até 300 caracteres (ou vazio)
    function validLinks(l) {
      return textList(l, 10, '^(https?://[^¶]{1,292})?(¶(https?://[^¶]{1,292})?)*$');
    }

    // De onde veio cada dado: chave = nome do campo, valor = texto curto (ex.: 'google_maps')
    function validSources(s) {
      return s is map
        && s.keys().hasOnly([
          'name', 'company', 'whatsapp', 'email', 'role', 'instagram', 'niche', 'city', 'state',
          'currentSite', 'siteStatus', 'siteScore', 'siteReason', 'googleRating', 'googleReviews',
          'cnpj', 'companyYears', 'phone', 'linkedin', 'companyLinkedin', 'companyEmail',
          'cnpjEmail', 'cnpjPhone', 'legalName', 'googleMapsUrl', 'facebook', 'address',
          'otherLinks', 'channel', 'fitReason'
        ])
        // cada valor: texto de até 40 caracteres
        && noSep(s.values())
        && s.values().join('¶').matches('^[^¶]{0,40}(¶[^¶]{0,40})*$');
    }

    function validDraft(m) {
      return m is map
        && m.keys().hasOnly(['channel', 'text', 'approved', 'approvedAt', 'sentAt', 'previewId'])
        && m.get('previewId', '').matches('^[A-Za-z0-9]{0,40}$')
        && m.get('channel', '') in ['', 'whatsapp', 'instagram', 'email']
        && m.get('text', '').matches('^[\\s\\S]{0,1000}[\\s\\S]{0,1000}$')
        && m.get('approved', false) is bool
        && tsOrNull(m.get('approvedAt', null))
        && tsOrNull(m.get('sentAt', null));
    }

    function validNextStep(m) {
      return m is map
        && m.keys().hasOnly(['text', 'dueAt'])
        && m.get('text', '').matches('^[\\s\\S]{0,300}$')
        && tsOrNull(m.get('dueAt', null));
    }

    // Cadastro manual pelo admin (indicação ou contato que chegou fora do site).
    // Os valores de cada campo são conferidos por validCrmFields, no allow.
    function crmLeadShape(d) {
      return d.keys().hasOnly(crmEditable().concat(['createdAt', 'createdBy']))
        && d.createdBy == 'admin'
        && d.createdAt == request.time
        && d.origin in ['manual', 'indicacao']
        && d.status != 'contato'
        && hasNameOrCompany(d);
    }
    function hasNameOrCompany(d) {
      return d.get('name', '').size() >= 2 || d.get('company', '').size() >= 2;
    }

    function validInteraction(d) {
      return d.keys().hasOnly(['type', 'text', 'channel', 'from', 'to', 'createdAt', 'createdBy'])
        && d.type in ['mensagem_enviada', 'resposta', 'nota', 'mudanca_etapa', 'reuniao', 'proposta']
        && str(d.text, 2000)
        && d.channel in ['', 'whatsapp', 'instagram', 'email', 'telefone', 'outro']
        && str(d.from, 40) && str(d.to, 40)
        && d.createdAt == request.time
        && d.createdBy in ['admin', 'cronus'];
    }

    // Campos que o CronUS pode gravar (lista fechada). Fora dela: notes, owner, lostReason,
    // discardReason, origin, createdAt, createdBy e todos os campos vindos do site.
    function botEditable() {
      return [
        'status', 'updatedAt', 'stageAt', 'name', 'company', 'whatsapp', 'email', 'need',
        'role', 'instagram', 'niche', 'city', 'state', 'currentSite', 'siteStatus', 'siteScore',
        'siteReason', 'googleRating', 'googleReviews', 'cnpj', 'companyYears', 'phone', 'linkedin',
        'companyLinkedin', 'companyEmail', 'cnpjEmail', 'cnpjPhone', 'legalName', 'googleMapsUrl',
        'facebook', 'address', 'otherLinks', 'sources', 'channel', 'fitReason', 'draft', 'previewId',
        'batchId', 'nextStep', 'meetingAt', 'prospectState', 'drafts', 'qualification',
        'disqualifyReason', 'format', 'formatReason', 'brand'
      ];
    }
    function botStages() { return ['novo', 'mensagem_pronta', 'abordado', 'respondeu', 'em_conversa', 'reuniao']; }

    // A mensagem do bot nasce pendente da aprovação do Pedro
    function botDraft(m) {
      return (!('approved' in m) || m.approved == false)
        && (!('approvedAt' in m) || m.approvedAt == null)
        && (!('sentAt' in m) || m.sentAt == null);
    }

    // Lead do CronUS: criado por ele (origin e createdBy). Um admin pode mudar a origem de
    // um lead para 'cronus', mas createdBy é imutável, então o bot continua sem acesso.
    function isBotLead(d) { return d.get('origin', '') == 'cronus' && d.get('createdBy', '') == 'cronus'; }

    // Update do bot: só campos dele e dentro dos limites (n = novo, o = atual)
    function botUpdate(n, o) {
      let k = n.diff(o).affectedKeys();
      return k.hasOnly(botEditable())
        && (!('status' in k) || n.status in botStages())
        && (!('prospectState' in k) || (n.prospectState == 'pendente'
            && !(o.get('prospectState', '') in ['aprovado', 'descartado'])))
        && (!('draft' in k) || (botDraft(n.draft) && botDraft(o.get('draft', {}))));
    }

    // Formato do lead criado pelo CronUS (os valores vão em validCrmFields, no allow)
    function botLeadShape(d) {
      return d.keys().hasOnly(botEditable().concat(['origin', 'createdAt', 'createdBy']))
        && d.origin == 'cronus'
        && d.createdBy == 'cronus'
        && d.createdAt == request.time
        && d.status in botStages()
        && d.get('prospectState', 'pendente') == 'pendente'
        && botDraft(d.get('draft', {}))
        && hasNameOrCompany(d);
    }

    // ---------------- Todo o resto: fechado ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
