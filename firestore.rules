rules_version = '2';

// Cron Web Studio · Regras do Firestore
// Princípio: tudo fechado por padrão; cada coleção libera só o mínimo necessário.
//
// - projects: visitante lê só os publicados; admin cria/edita/exclui com campos validados
// - leads: visitante só CRIA pelo formulário (campos validados + consentimento LGPD);
//          o admin lê, cadastra leads manuais e edita os campos de CRM (nunca consentimento,
//          UTM, data de criação ou de onde o lead clicou no site)
// - leads/{id}/interacoes: histórico do lead; admin lê, cria e apaga (ao excluir o lead); ninguém edita
// - leads/{id}/kit/marca: logo e produtos do lead (pesados, fora do documento do lead); só admin
// - previews: sites modelo; visitante lê só a prévia ativa pelo id (nunca lista); admin gerencia
// - rodadas: rodadas de prospecção; admin lê, cria e edita; nunca apaga (arquiva)
// - admins: cada documento com o UID libera o painel; admins gerenciam outros admins
//           pelo painel (ninguém remove o próprio acesso nem o do dono)
// - bots: cada documento com o UID libera o CronUS a gravar prospecção (nunca entra no painel)
// - config/owner: UID do dono do sistema; criado uma vez, nunca alterado nem apagado
//
// O CronUS (bot) lê leads, histórico, kit, prévias e rodadas; cria e atualiza só o que é
// de prospecção (leads com origin 'cronus'); nunca apaga, nunca aprova mensagem, nunca
// fecha ou perde lead e nunca toca em projetos, admins, bots ou config.
// - qualquer outra coleção: bloqueada

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // CronUS: conta dedicada com documento em bots/{uid}
    function isBot() {
      return request.auth != null
        && exists(/databases/$(database)/documents/bots/$(request.auth.uid));
    }

    function ownerPath() { return /databases/$(database)/documents/config/owner; }

    // ---------------- Admins ----------------
    match /admins/{uid} {
      // cada pessoa lê o próprio documento (o painel confere o acesso); admin lê todos
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // a mesma conta nunca é admin e bot ao mesmo tempo
      allow create: if isAdmin() && uid.matches('^[A-Za-z0-9]{20,40}$') && validAdmin(request.resource.data)
        && !exists(/databases/$(database)/documents/bots/$(uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && (!('name' in request.resource.data) || str(request.resource.data.name, 80))
        && (!('email' in request.resource.data) || mail(request.resource.data.email))
        && request.resource.data.updatedAt == request.time;
      // remover o acesso de outra pessoa; o próprio, nunca; o do dono, nunca.
      // Sem config/owner criado, ninguém remove admin pelo app (proposital).
      allow delete: if isAdmin() && request.auth.uid != uid
        && exists(ownerPath())
        && get(ownerPath()).data.uid != uid;
    }

    // ---------------- Bots (CronUS) ----------------
    match /bots/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && uid.matches('^[A-Za-z0-9]{20,40}$') && validBot(request.resource.data)
        && !exists(/databases/$(database)/documents/admins/$(uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && (!('name' in request.resource.data) || str(request.resource.data.name, 80))
        && (!('email' in request.resource.data) || mail(request.resource.data.email))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    function validBot(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'createdBy'])
        && str(d.name, 80) && d.name.size() >= 2
        && mail(d.email)
        && d.role == 'bot'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }

    // ---------------- Dono do sistema ----------------
    // Documento único config/owner { uid, createdAt }. Criado uma vez (bootstrap) e imutável.
    match /config/{docId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && docId == 'owner'
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid is string && request.resource.data.uid.matches('^[A-Za-z0-9]{20,40}$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    function validAdmin(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'createdBy'])
        && str(d.name, 80)
        && mail(d.email) && d.email.size() > 0
        && d.role == 'admin'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }

    // ---------------- Sites modelo (prévias) ----------------
    match /previews/{id} {
      // público abre só a prévia ativa, pelo id aleatório; nunca lista.
      // A condição barata vem primeiro: o visitante não paga as consultas de papel.
      allow get: if resource.data.active == true || isAdmin() || isBot();
      allow list: if isAdmin() || isBot();
      allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
          || (isBot() && request.resource.data.createdBy == 'cronus'))
        && validPreview(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin() || isBot())
        && validPreview(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      // só a exclusão completa do lead (LGPD) apaga; no dia a dia, desativa
      allow delete: if isAdmin();
    }

    // Imagem embutida: data URL de webp, png ou jpeg (ou vazio)
    function img(v, max) {
      return v is string && v.size() <= max
        && (v == '' || v.matches('^data:image/(webp|png|jpeg);base64,.+'));
    }
    function color(v) { return v is string && v.matches('^(#[0-9a-fA-F]{6})?$'); }

    // Listas de textos curtos: as regras não têm laço, cada posição é conferida
    function strAt(l, i, max) { return l.size() <= i || str(l[i], max); }
    function list6(l, max) {
      return l is list && l.size() <= 6
        && strAt(l, 0, max) && strAt(l, 1, max) && strAt(l, 2, max)
        && strAt(l, 3, max) && strAt(l, 4, max) && strAt(l, 5, max);
    }
    function strs4(l, o, max) {
      return strAt(l, o, max) && strAt(l, o + 1, max) && strAt(l, o + 2, max) && strAt(l, o + 3, max);
    }
    function list8(l, max) { return l is list && l.size() <= 8 && strs4(l, 0, max) && strs4(l, 4, max); }
    function list12(l, max) {
      return l is list && l.size() <= 12 && strs4(l, 0, max) && strs4(l, 4, max) && strs4(l, 8, max);
    }

    // Produtos do catálogo: até 24, cada um conferido na sua posição
    function validProduct(m) {
      return m is map
        && m.keys().hasOnly(['name', 'description', 'category', 'image'])
        && str(m.name, 60) && m.name.size() >= 1
        && (!('description' in m) || str(m.description, 160))
        && (!('category' in m) || str(m.category, 40))
        && (!('image' in m) || img(m.image, 30000));
    }
    function prodAt(l, i) { return l.size() <= i || validProduct(l[i]); }
    function products8(l, o) {
      return prodAt(l, o) && prodAt(l, o + 1) && prodAt(l, o + 2) && prodAt(l, o + 3)
        && prodAt(l, o + 4) && prodAt(l, o + 5) && prodAt(l, o + 6) && prodAt(l, o + 7);
    }
    function validProducts(l) {
      return l is list && l.size() <= 24 && products8(l, 0) && products8(l, 8) && products8(l, 16);
    }

    function validTexts(t) {
      return t is map
        && t.keys().hasOnly(['headline', 'subheadline', 'about', 'ctaPrimary', 'ctaSecondary',
                             'contactTitle', 'contactText', 'catalogTitle', 'catalogText',
                             'diferenciais', 'benefits'])
        && (!('headline' in t) || str(t.headline, 120))
        && (!('subheadline' in t) || str(t.subheadline, 240))
        && (!('about' in t) || str(t.about, 900))
        && (!('ctaPrimary' in t) || str(t.ctaPrimary, 40))
        && (!('ctaSecondary' in t) || str(t.ctaSecondary, 40))
        && (!('contactTitle' in t) || str(t.contactTitle, 80))
        && (!('contactText' in t) || str(t.contactText, 240))
        && (!('catalogTitle' in t) || str(t.catalogTitle, 80))
        && (!('catalogText' in t) || str(t.catalogText, 240))
        && (!('diferenciais' in t) || list6(t.diferenciais, 120))
        && (!('benefits' in t) || list6(t.benefits, 120));
    }

    // Prévia é pública por link: nada interno do lead (contatos, cidade, notas, motivos,
    // id do lead ou nicho). A ligação com o lead fica no índice privado leads/{id}/previews.
    function validPreview(d) {
      return d.keys().hasOnly(['template', 'format',
                               'companyName', 'tagline', 'mainService', 'services',
                               'primaryColor', 'secondaryColor', 'logo', 'products', 'categories',
                               'texts', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && d.template is string && d.template.matches('^[a-z0-9_-]{2,60}$')
        && d.format in ['landing', 'institucional', 'catalogo']
        && str(d.companyName, 120) && d.companyName.size() >= 2
        && (!('tagline' in d) || str(d.tagline, 120))
        && (!('mainService' in d) || str(d.mainService, 80))
        && (!('services' in d) || list8(d.services, 60))
        && (!('primaryColor' in d) || color(d.primaryColor))
        && (!('secondaryColor' in d) || color(d.secondaryColor))
        && (!('logo' in d) || img(d.logo, 200000))
        && (!('products' in d) || validProducts(d.products))
        && (!('categories' in d) || list12(d.categories, 40))
        && (!('texts' in d) || validTexts(d.texts))
        && d.active is bool
        && d.createdBy in ['admin', 'cronus'];
    }

    function validKit(d) {
      return d.keys().hasOnly(['logo', 'products', 'categories', 'updatedAt', 'updatedBy'])
        && (!('logo' in d) || img(d.logo, 200000))
        && (!('products' in d) || validProducts(d.products))
        && (!('categories' in d) || list12(d.categories, 40))
        && d.updatedAt == request.time
        && d.updatedBy in ['admin', 'cronus'];
    }

    // Índice privado de prévias do lead: id igual ao da prévia pública
    function validPreviewIndex(d) {
      return d.keys().hasOnly(['niche', 'formatReason', 'createdAt'])
        && (!('niche' in d) || (d.niche is string && d.niche.matches('^([a-z0-9-]{2,60})?$')))
        && (!('formatReason' in d) || str(d.formatReason, 300))
        && d.createdAt is timestamp;
    }

    function validBrand(m) {
      return m is map
        && m.keys().hasOnly(['primaryColor', 'secondaryColor', 'tagline', 'mainService', 'services'])
        && (!('primaryColor' in m) || color(m.primaryColor))
        && (!('secondaryColor' in m) || color(m.secondaryColor))
        && (!('tagline' in m) || str(m.tagline, 120))
        && (!('mainService' in m) || str(m.mainService, 80))
        && (!('services' in m) || list8(m.services, 60));
    }

    // ---------------- Rodadas de prospecção ----------------
    match /rodadas/{id} {
      allow get, list: if isAdmin() || isBot();
      allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
          || (isBot() && request.resource.data.createdBy == 'cronus'))
        && request.resource.data.createdAt == request.time
        && validRodada(request.resource.data);
      // o bot atualiza tudo menos arquivar (arquivar é decisão do admin)
      allow update: if (isAdmin() || (isBot()
          && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.status != 'arquivada')))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['niche', 'nicheLabel', 'region', 'criteria', 'funnel', 'status', 'notes', 'updatedAt'])
        && validRodada(request.resource.data);
      allow delete: if false;
    }

    function siteStAt(l, i) { return l.size() <= i || l[i] in ['sem_site', 'site_fraco', 'ok']; }
    function cnt(m, k) { return !(k in m) || (m[k] is int && m[k] >= 0 && m[k] <= 100000); }

    function validRodada(d) {
      return d.keys().hasOnly(['niche', 'nicheLabel', 'region', 'criteria', 'funnel', 'status', 'notes',
                               'createdBy', 'createdAt', 'updatedAt'])
        && d.niche is string && d.niche.matches('^[a-z0-9-]{2,60}$')
        && str(d.nicheLabel, 80)
        && (!('region' in d) || str(d.region, 120))
        && (!('notes' in d) || str(d.notes, 2000))
        && d.status in ['em_andamento', 'concluida', 'arquivada']
        && d.createdBy in ['admin', 'cronus']
        && (!('criteria' in d) || (d.criteria is map
            && d.criteria.keys().hasOnly(['minRating', 'minReviews', 'siteStatusAccepted', 'requireContact'])
            && (!('minRating' in d.criteria) || (d.criteria.minRating is number && d.criteria.minRating >= 0 && d.criteria.minRating <= 5))
            && (!('minReviews' in d.criteria) || (d.criteria.minReviews is int && d.criteria.minReviews >= 0 && d.criteria.minReviews <= 100000))
            && (!('requireContact' in d.criteria) || d.criteria.requireContact is bool)
            && (!('siteStatusAccepted' in d.criteria) || (d.criteria.siteStatusAccepted is list
                && d.criteria.siteStatusAccepted.size() <= 3
                && siteStAt(d.criteria.siteStatusAccepted, 0)
                && siteStAt(d.criteria.siteStatusAccepted, 1)
                && siteStAt(d.criteria.siteStatusAccepted, 2)))))
        && (!('funnel' in d) || (d.funnel is map
            && d.funnel.keys().hasOnly(['encontradas', 'notaMinima', 'avaliacoes', 'siteSemOuFraco', 'comContato', 'qualificadas'])
            && cnt(d.funnel, 'encontradas') && cnt(d.funnel, 'notaMinima') && cnt(d.funnel, 'avaliacoes')
            && cnt(d.funnel, 'siteSemOuFraco') && cnt(d.funnel, 'comContato') && cnt(d.funnel, 'qualificadas')));
    }

    // ---------------- Projetos ----------------
    match /projects/{id} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validProject(request.resource.data);
      allow delete: if isAdmin();
    }

    function str(v, max) { return v is string && v.size() <= max; }

    function validProject(d) {
      return d.keys().hasOnly([
          'client', 'segment', 'title', 'description', 'quote', 'tags',
          'ctaLabel', 'siteLabel', 'siteUrl', 'image', 'imageAlt',
          'published', 'order', 'createdAt', 'updatedAt'
        ])
        && str(d.client, 60) && d.client.size() >= 2
        && str(d.title, 120) && d.title.size() >= 2
        && str(d.segment, 60)
        && str(d.description, 600)
        && d.quote is map && d.quote.keys().hasOnly(['text', 'author'])
        && str(d.quote.text, 300) && str(d.quote.author, 80)
        && d.tags is list && d.tags.size() <= 6
        && str(d.ctaLabel, 40) && str(d.siteLabel, 40)
        && str(d.siteUrl, 300) && (d.siteUrl == '' || d.siteUrl.matches('^https?://.+'))
        && str(d.imageAlt, 160)
        && d.image is string && d.image.size() <= 900000
        && (d.image == '' || d.image.matches('^data:image/(webp|png|jpeg);base64,.+'))
        && d.published is bool
        && d.order is int && d.order >= 0 && d.order <= 10;
    }

    // ---------------- Leads ----------------
    match /leads/{id} {
      // Formulário do site (exatamente como antes) ou cadastro manual pelo admin
      allow create: if validLead(request.resource.data)
        || (isAdmin() && validCrmLead(request.resource.data))
        || (isBot() && validBotLead(request.resource.data));
      allow get, list: if isAdmin() || isBot();
      // Admin edita só campos de CRM; o documento resultante precisa continuar válido.
      // Bot edita só leads de prospecção (origin 'cronus') e só os campos dele.
      allow update: if ((isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(crmEditable()))
          || (isBot() && resource.data.origin == 'cronus'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(botEditable())
            && botLimits(request.resource.data, resource.data,
                         request.resource.data.diff(resource.data).affectedKeys())))
        && validCrmFields(request.resource.data);
      allow delete: if isAdmin();

      // Kit da marca (logo e produtos): documento único 'marca'. Apagado só na exclusão completa.
      // O bot grava só no kit de lead de prospecção.
      match /kit/{docId} {
        allow get, list: if isAdmin() || isBot();
        allow create, update: if docId == 'marca'
          && ((isAdmin() && request.resource.data.updatedBy == 'admin')
            || (isBot() && request.resource.data.updatedBy == 'cronus'
              && getAfter(/databases/$(database)/documents/leads/$(id)).data.origin == 'cronus'))
          && validKit(request.resource.data);
        allow delete: if isAdmin();
      }

      // Índice privado das prévias do lead (a prévia pública não sabe de qual lead é)
      match /previews/{pid} {
        allow get, list: if isAdmin() || isBot();
        allow create: if (isAdmin() || isBot())
          && validPreviewIndex(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if (isAdmin() || isBot())
          && validPreviewIndex(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin();
      }

      // Histórico: ninguém edita. O admin apaga só junto com o lead (exclusão completa, LGPD).
      match /interacoes/{iid} {
        allow get, list: if isAdmin() || isBot();
        allow create: if ((isAdmin() && request.resource.data.createdBy == 'admin')
            || (isBot() && request.resource.data.createdBy == 'cronus'))
          && validInteraction(request.resource.data);
        allow delete: if isAdmin();
        allow update: if false;
      }
    }

    // Formulário público do site (sem mudanças)
    function validLead(d) {
      return d.keys().hasOnly([
          'name', 'whatsapp', 'email', 'company', 'need', 'message',
          'source', 'sourceLabel', 'project',
          'consent', 'consentText', 'consentAt',
          'createdAt', 'status', 'notes', 'page', 'referrer', 'utm'
        ])
        && str(d.name, 120) && d.name.size() >= 2
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10,13}$')
        && str(d.email, 160) && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && str(d.company, 120)
        && d.need in ['', 'institucional', 'sistema', 'nao-sei']
        && str(d.message, 2000)
        && str(d.source, 80) && str(d.sourceLabel, 120) && str(d.project, 120)
        && d.consent == true
        && str(d.consentText, 600)
        && d.consentAt == request.time
        && d.createdAt == request.time
        && d.status == 'novo'
        && d.notes == ''
        && str(d.page, 500) && str(d.referrer, 500)
        && d.utm is map && d.utm.size() <= 5
        && d.utm.keys().hasOnly(['source', 'medium', 'campaign', 'content', 'term'])
        && (!('source' in d.utm) || str(d.utm.source, 120))
        && (!('medium' in d.utm) || str(d.utm.medium, 120))
        && (!('campaign' in d.utm) || str(d.utm.campaign, 120))
        && (!('content' in d.utm) || str(d.utm.content, 120))
        && (!('term' in d.utm) || str(d.utm.term, 120));
    }

    // Campos que o admin pode alterar num lead existente.
    // Fora da lista (imutáveis): createdAt, createdBy, consent, consentText, consentAt,
    // utm, source, sourceLabel, project, page, referrer, message.
    function crmEditable() {
      return [
        'status', 'notes', 'updatedAt', 'stageAt',
        'name', 'company', 'whatsapp', 'email', 'need',
        'origin', 'role', 'instagram', 'niche', 'city', 'state',
        'currentSite', 'siteStatus', 'siteScore', 'siteReason',
        'googleRating', 'googleReviews', 'cnpj', 'companyYears',
        'phone', 'linkedin', 'companyLinkedin', 'companyEmail', 'cnpjEmail', 'cnpjPhone',
        'legalName', 'googleMapsUrl', 'facebook', 'address', 'otherLinks', 'sources',
        'channel', 'fitReason', 'draft', 'previewId', 'batchId', 'owner',
        'nextStep', 'meetingAt', 'lostReason',
        'prospectState', 'drafts', 'discardReason',
        'qualification', 'disqualifyReason', 'format', 'formatReason', 'brand'
      ];
    }

    // Etapas do funil. 'contato' fica aceito para leads antigos (o painel mostra como "Em conversa").
    function stages() {
      return ['novo', 'mensagem_pronta', 'abordado', 'respondeu', 'em_conversa',
              'reuniao', 'proposta', 'fechado', 'perdido', 'contato'];
    }

    function url(v) { return str(v, 300) && (v == '' || v.matches('^https?://.+')); }
    function mail(v) { return str(v, 160) && (v == '' || v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')); }
    function tsOrNull(v) { return v == null || v is timestamp; }

    // Valida só os campos de CRM presentes (todos opcionais, exceto status).
    function validCrmFields(d) {
      return d.status in stages()
        && (!('notes' in d) || str(d.notes, 5000))
        && (!('stageAt' in d) || d.stageAt is timestamp)
        && (!('name' in d) || str(d.name, 120))
        && (!('company' in d) || str(d.company, 120))
        && (!('whatsapp' in d) || (d.whatsapp is string && d.whatsapp.matches('^([0-9]{10,13})?$')))
        && (!('email' in d) || mail(d.email))
        && (!('need' in d) || d.need in ['', 'institucional', 'sistema', 'nao-sei'])
        && (!('origin' in d) || d.origin in ['site', 'cronus', 'indicacao', 'manual'])
        && (!('role' in d) || str(d.role, 80))
        && (!('instagram' in d) || (d.instagram is string && d.instagram.matches('^[A-Za-z0-9._]{0,30}$')))
        && (!('niche' in d) || (d.niche is string && d.niche.matches('^[a-z0-9-]{0,60}$')))
        && (!('city' in d) || str(d.city, 80))
        && (!('state' in d) || (d.state is string && d.state.matches('^([A-Z]{2})?$')))
        && (!('currentSite' in d) || url(d.currentSite))
        && (!('siteStatus' in d) || d.siteStatus in ['', 'sem_site', 'site_fraco', 'ok'])
        && (!('siteScore' in d) || (d.siteScore is int && d.siteScore >= 0 && d.siteScore <= 10))
        && (!('siteReason' in d) || str(d.siteReason, 300))
        && (!('googleRating' in d) || (d.googleRating is number && d.googleRating >= 0 && d.googleRating <= 5))
        && (!('googleReviews' in d) || (d.googleReviews is int && d.googleReviews >= 0 && d.googleReviews <= 1000000))
        && (!('cnpj' in d) || (d.cnpj is string && d.cnpj.matches('^([0-9]{14})?$')))
        && (!('companyYears' in d) || (d.companyYears is int && d.companyYears >= 0 && d.companyYears <= 200))
        && (!('phone' in d) || (d.phone is string && d.phone.matches('^([0-9]{8,13})?$')))
        && (!('linkedin' in d) || url(d.linkedin))
        && (!('companyLinkedin' in d) || url(d.companyLinkedin))
        && (!('companyEmail' in d) || mail(d.companyEmail))
        && (!('cnpjEmail' in d) || mail(d.cnpjEmail))
        && (!('cnpjPhone' in d) || (d.cnpjPhone is string && d.cnpjPhone.matches('^([0-9]{8,13})?$')))
        && (!('legalName' in d) || str(d.legalName, 160))
        && (!('googleMapsUrl' in d) || url(d.googleMapsUrl))
        && (!('facebook' in d) || url(d.facebook))
        && (!('address' in d) || str(d.address, 300))
        && (!('otherLinks' in d) || validLinks(d.otherLinks))
        && (!('sources' in d) || validSources(d.sources))
        && (!('channel' in d) || d.channel in ['', 'whatsapp', 'instagram', 'email'])
        && (!('fitReason' in d) || str(d.fitReason, 600))
        && (!('draft' in d) || validDraft(d.draft))
        && (!('previewId' in d) || (d.previewId is string && d.previewId.matches('^[A-Za-z0-9]{0,40}$')))
        && (!('batchId' in d) || (d.batchId is string && d.batchId.matches('^[A-Za-z0-9]{0,40}$')))
        && (!('owner' in d) || str(d.owner, 40))
        && (!('nextStep' in d) || validNextStep(d.nextStep))
        && (!('meetingAt' in d) || tsOrNull(d.meetingAt))
        && (!('lostReason' in d) || str(d.lostReason, 300))
        && (!('prospectState' in d) || d.prospectState in ['pendente', 'aprovado', 'descartado'])
        && (!('discardReason' in d) || str(d.discardReason, 300))
        && (!('qualification' in d) || d.qualification in ['', 'qualificado', 'desqualificado'])
        && (!('disqualifyReason' in d) || str(d.disqualifyReason, 300))
        && (!('format' in d) || d.format in ['', 'landing', 'institucional', 'catalogo'])
        && (!('formatReason' in d) || str(d.formatReason, 300))
        && (!('brand' in d) || validBrand(d.brand))
        && (!('drafts' in d) || (d.drafts is map
            && d.drafts.keys().hasOnly(['whatsapp', 'instagram', 'email'])
            && (!('whatsapp' in d.drafts) || str(d.drafts.whatsapp, 2000))
            && (!('instagram' in d.drafts) || str(d.drafts.instagram, 2000))
            && (!('email' in d.drafts) || str(d.drafts.email, 2000))));
    }

    // Até 10 links, cada um http/https (as regras não têm laço, então cada posição é conferida)
    function linkAt(l, i) { return l.size() <= i || url(l[i]); }
    function validLinks(l) {
      return l is list && l.size() <= 10
        && linkAt(l, 0) && linkAt(l, 1) && linkAt(l, 2) && linkAt(l, 3) && linkAt(l, 4)
        && linkAt(l, 5) && linkAt(l, 6) && linkAt(l, 7) && linkAt(l, 8) && linkAt(l, 9);
    }

    // De onde veio cada dado: chave = nome do campo, valor = texto curto (ex.: 'google_maps')
    function srcOk(s, k) { return !(k in s) || str(s[k], 40); }
    function validSources(s) {
      return s is map
        && s.keys().hasOnly([
          'name', 'company', 'whatsapp', 'email', 'role', 'instagram', 'niche', 'city', 'state',
          'currentSite', 'siteStatus', 'siteScore', 'siteReason', 'googleRating', 'googleReviews',
          'cnpj', 'companyYears', 'phone', 'linkedin', 'companyLinkedin', 'companyEmail',
          'cnpjEmail', 'cnpjPhone', 'legalName', 'googleMapsUrl', 'facebook', 'address',
          'otherLinks', 'channel', 'fitReason'
        ])
        && srcOk(s, 'name') && srcOk(s, 'company') && srcOk(s, 'whatsapp') && srcOk(s, 'email')
        && srcOk(s, 'role') && srcOk(s, 'instagram') && srcOk(s, 'niche') && srcOk(s, 'city')
        && srcOk(s, 'state') && srcOk(s, 'currentSite') && srcOk(s, 'siteStatus') && srcOk(s, 'siteScore')
        && srcOk(s, 'siteReason') && srcOk(s, 'googleRating') && srcOk(s, 'googleReviews') && srcOk(s, 'cnpj')
        && srcOk(s, 'companyYears') && srcOk(s, 'phone') && srcOk(s, 'linkedin') && srcOk(s, 'companyLinkedin')
        && srcOk(s, 'companyEmail') && srcOk(s, 'cnpjEmail') && srcOk(s, 'cnpjPhone') && srcOk(s, 'legalName')
        && srcOk(s, 'googleMapsUrl') && srcOk(s, 'facebook') && srcOk(s, 'address') && srcOk(s, 'otherLinks')
        && srcOk(s, 'channel') && srcOk(s, 'fitReason');
    }

    function validDraft(m) {
      return m is map
        && m.keys().hasOnly(['channel', 'text', 'approved', 'approvedAt', 'sentAt', 'previewId'])
        && (!('previewId' in m) || (m.previewId is string && m.previewId.matches('^[A-Za-z0-9]{0,40}$')))
        && (!('channel' in m) || m.channel in ['', 'whatsapp', 'instagram', 'email'])
        && (!('text' in m) || str(m.text, 2000))
        && (!('approved' in m) || m.approved is bool)
        && (!('approvedAt' in m) || tsOrNull(m.approvedAt))
        && (!('sentAt' in m) || tsOrNull(m.sentAt));
    }

    function validNextStep(m) {
      return m is map
        && m.keys().hasOnly(['text', 'dueAt'])
        && (!('text' in m) || str(m.text, 300))
        && (!('dueAt' in m) || tsOrNull(m.dueAt));
    }

    // Cadastro manual pelo admin (indicação ou contato que chegou fora do site)
    function validCrmLead(d) {
      return d.keys().hasOnly(crmEditable().concat(['createdAt', 'createdBy']))
        && d.createdBy == 'admin'
        && d.createdAt == request.time
        && d.origin in ['manual', 'indicacao']
        && d.status in stages() && d.status != 'contato'
        && ((('name' in d) && d.name is string && d.name.size() >= 2)
            || (('company' in d) && d.company is string && d.company.size() >= 2))
        && validCrmFields(d);
    }

    function validInteraction(d) {
      return d.keys().hasOnly(['type', 'text', 'channel', 'from', 'to', 'createdAt', 'createdBy'])
        && d.type in ['mensagem_enviada', 'resposta', 'nota', 'mudanca_etapa', 'reuniao', 'proposta']
        && str(d.text, 2000)
        && d.channel in ['', 'whatsapp', 'instagram', 'email', 'telefone', 'outro']
        && str(d.from, 40) && str(d.to, 40)
        && d.createdAt == request.time
        && d.createdBy in ['admin', 'cronus'];
    }

    // Campos que o CronUS pode gravar (lista fechada). Fora dela: notes, owner, lostReason,
    // discardReason, origin, createdAt, createdBy e todos os campos vindos do site.
    function botEditable() {
      return [
        'status', 'updatedAt', 'stageAt', 'name', 'company', 'whatsapp', 'email', 'need',
        'role', 'instagram', 'niche', 'city', 'state', 'currentSite', 'siteStatus', 'siteScore',
        'siteReason', 'googleRating', 'googleReviews', 'cnpj', 'companyYears', 'phone', 'linkedin',
        'companyLinkedin', 'companyEmail', 'cnpjEmail', 'cnpjPhone', 'legalName', 'googleMapsUrl',
        'facebook', 'address', 'otherLinks', 'sources', 'channel', 'fitReason', 'draft', 'previewId',
        'batchId', 'nextStep', 'meetingAt', 'prospectState', 'drafts', 'qualification',
        'disqualifyReason', 'format', 'formatReason', 'brand'
      ];
    }
    function botStages() { return ['novo', 'mensagem_pronta', 'abordado', 'respondeu', 'em_conversa', 'reuniao']; }

    // A mensagem do bot nasce pendente da aprovação do Pedro
    function botDraft(m) {
      return (!('approved' in m) || m.approved == false)
        && (!('approvedAt' in m) || m.approvedAt == null)
        && (!('sentAt' in m) || m.sentAt == null);
    }

    // Limites do bot num update (k = campos alterados)
    function botLimits(n, o, k) {
      return (!('status' in k) || n.status in botStages())
        && (!('prospectState' in k) || (n.prospectState == 'pendente'
            && !(('prospectState' in o) && o.prospectState in ['aprovado', 'descartado'])))
        && (!('draft' in k) || botDraft(n.draft));
    }

    // Lead criado pelo CronUS
    function validBotLead(d) {
      return d.keys().hasOnly(botEditable().concat(['origin', 'createdAt', 'createdBy']))
        && d.origin == 'cronus'
        && d.createdBy == 'cronus'
        && d.createdAt == request.time
        && d.status in botStages()
        && (!('prospectState' in d) || d.prospectState == 'pendente')
        && (!('draft' in d) || botDraft(d.draft))
        && ((('name' in d) && d.name is string && d.name.size() >= 2)
            || (('company' in d) && d.company is string && d.company.size() >= 2))
        && validCrmFields(d);
    }

    // ---------------- Todo o resto: fechado ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
